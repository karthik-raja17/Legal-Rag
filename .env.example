# Vector Store (FAISS HNSW)
VECTOR_STORE_TYPE=faiss
FAISS_INDEX_DIR=./data/faiss_index
HNSW_M=24
HNSW_EF_CONSTRUCTION=100
HNSW_EF_SEARCH=100

# Local Embeddings (Qwen3-Embedding MRL 512d)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_NAME=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIMENSION=512
EMBEDDING_BATCH_SIZE=32

# Local LLM (Ollama)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Storage & Cache
LOCAL_STORAGE_DIR=./data/storage
BM25_CACHE_DIR=./data/bm25_cache
PARSER_CACHE_DIR=./data/parser_cache

# Hybrid Retrieval & Reranking
HYBRID_DENSE_WEIGHT=0.6
HYBRID_BM25_WEIGHT=0.4
HYBRID_RRF_K=60
HYBRID_TOP_K=10

RERANKER_TYPE=local_cross_encoder
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_CANDIDATE_K=60

# Query Intelligence
ENABLE_QUERY_REWRITING=true
ENABLE_QUERY_EXPANSION=false
QUERY_ANALYZER_ENABLED=true
QUERY_ANALYZER_MODE=heuristic

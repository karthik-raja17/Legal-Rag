# Stage 1: Download model files via Python
FROM python:3.11-slim AS downloader
RUN pip install --no-cache-dir huggingface_hub
RUN python -c "from huggingface_hub import snapshot_download; snapshot_download('BAAI/bge-m3', local_dir='/model')"

# Stage 2: TEI Runtime
FROM ghcr.io/huggingface/text-embeddings-inference:cpu-1.5

ENV PORT=8080

# Copy model artifacts from downloader stage
COPY --from=downloader /model /model

# Point TEI directly to the local directory
ENTRYPOINT ["text-embeddings-router", "--model-id", "/model", "--hostname", "0.0.0.0", "--port", "8080", "--max-concurrent-requests", "64", "--auto-truncate"]